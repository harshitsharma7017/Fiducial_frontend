# Copy to .env.local for local development. Never commit .env files.

# Mock API mode. true: the app signs in demo users and never calls Fiducial_backend, so you can
# use the shell without the API. Any other value (or unset) uses the real API at API_URL.
# Never set this to true where real users sign in: anyone could sign in as the demo admin.
# Demo users, one per role (password Fiducial-demo-2026): demo.admin@example.com (Admin),
# demo.manager@example.com (Relationship Manager), demo.approver@example.com (Approver),
# demo.placement@example.com (Underwriting / Placement), demo.readonly@example.com (Read-only).
USE_MOCK_API=true

# The Express API (Fiducial_backend). Server-only: used by the Next.js route handlers, never sent
# to the browser. Needed only when USE_MOCK_API is not true.
API_URL=http://localhost:4000

# Optional. The public URL of fiducial-ghi-frontend (Employee Benefits: GMC, GPA, GTLI and group
# health claims). Notifications about those cases link there, and old employee claim links
# (/claim#t=...) are redirected there. Public (inlined at build time): never put a secret here.
# NEXT_PUBLIC_GHI_APP_URL=http://localhost:3002
